{
  "name": "Карманный ассистент (Telegram + Claude)",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": {}
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [0, 300],
      "webhookId": "b7e4a0d1-6c2f-4e8a-9a51-3f2d7c9e1a01"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c3d9e1f4-2a6b-4d7c-8e90-000000000010",
              "leftValue": "={{ $json.message.text }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000002",
      "name": "Есть текст?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [220, 300]
    },
    {
      "parameters": {
        "operation": "sendChatAction",
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}"
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000003",
      "name": "Печатает…",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [460, 200]
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "={{ $('Telegram Trigger').item.json.message.text }}",
        "options": {
          "systemMessage": "Ты — «карманный ассистент» пользователя в Telegram.\n\nОтвечай на языке сообщения пользователя. Пиши коротко и по делу: обычно 1–5 предложений; развёрнуто — только если пользователь просит подробностей.\n\nФорматирование: ответ показывается в Telegram как обычный текст, поэтому не используй Markdown-разметку (*, **, #, ```). Для списков используй «—» или цифры с точкой.\n\nЕсли вопрос неоднозначен — задай один уточняющий вопрос. Если не знаешь ответа или нужна актуальная информация из интернета — честно скажи, что у тебя нет доступа к свежим данным.\n\nНа команду /start поздоровайся и в одном-двух предложениях расскажи, чем можешь помочь."
        }
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000004",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [680, 200]
    },
    {
      "parameters": {
        "model": {
          "__rl": true,
          "value": "claude-sonnet-5",
          "mode": "list",
          "cachedResultName": "Claude Sonnet 5"
        },
        "options": {
          "maxTokensToSample": 1024,
          "temperature": 0.5
        }
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000005",
      "name": "Anthropic Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatAnthropic",
      "typeVersion": 1.3,
      "position": [620, 420]
    },
    {
      "parameters": {
        "sessionIdType": "customKey",
        "sessionKey": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "contextWindowLength": 10
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000006",
      "name": "Память диалога",
      "type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
      "typeVersion": 1.3,
      "position": [800, 420]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "={{ $json.output }}",
        "additionalFields": {
          "appendAttribution": false,
          "reply_to_message_id": "={{ $('Telegram Trigger').item.json.message.message_id }}"
        }
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000007",
      "name": "Ответ в Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1040, 200]
    },
    {
      "parameters": {
        "chatId": "={{ $('Telegram Trigger').item.json.message.chat.id }}",
        "text": "Пока я понимаю только текстовые сообщения. Напиши, пожалуйста, вопрос текстом 🙂",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000008",
      "name": "Не текст",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [460, 420]
    },
    {
      "parameters": {
        "jsCode": "// Строка лога успешного запроса. Колонки совпадают с логом ошибок из Error Handler,\n// поэтому обе ветки пишут в один лист и по нему считается error rate.\n// duration_sec — время от отправки сообщения пользователем до ответа бота (точность — секунды,\n// т. к. Telegram отдаёт message.date в секундах).\nconst message = $('Telegram Trigger').first().json.message;\nconst answer = String($('AI Agent').first().json.output ?? '');\n\nreturn [{\n  json: {\n    timestamp: $now.toFormat('yyyy-MM-dd HH:mm:ss'),\n    status: 'success',\n    workflow_id: $workflow.id,\n    workflow_name: $workflow.name,\n    node_name: '',\n    execution_id: $execution.id,\n    execution_url: '',\n    mode: $execution.mode,\n    error_type: '',\n    error_message: '',\n    error_stack: '',\n    duration_sec: Math.max(0, Math.round(Date.now() / 1000 - message.date)),\n    response_chars: answer.length,\n  },\n}];"
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000009",
      "name": "Собрать лог запроса",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1260, 200]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "sheetName": {
          "__rl": true,
          "value": "",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": []
        },
        "options": {}
      },
      "id": "a1f0c7d2-1b3e-4c5a-9d10-000000000010",
      "name": "Лог в Google Sheets",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1480, 200]
    }
  ],
